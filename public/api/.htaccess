Options -Indexes

<FilesMatch "^(config|db|security)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(json|lock|bak|old|orig|save|sql|env)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always unset Access-Control-Allow-Origin
  Header always unset X-Powered-By
</IfModule>
